# =============================================================================
# GëstuSaDine — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
#
# Server-side variables (AUTH_SECRET, FANAR_API_KEY, etc.) should be set via:
#   npx convex env set <NAME> <VALUE>
#
# See DEPLOYMENT.md for the full deployment guide.

# ── Frontend (required) ──────────────────────────────────────────────────────

# Convex deployment URL (required — get from `npx convex dev`)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# ── Backend (set via `npx convex env set`) ───────────────────────────────────

# Admin emails (comma-separated) — users with these emails get admin role
# ADMIN_EMAILS=admin@example.com

# Auth secret for Convex Auth (generate with: openssl rand -hex 32)
# AUTH_SECRET=your-random-secret

# Fanar API key for the AI chat assistant (https://api.fanar.qa)
# FANAR_API_KEY=your-fanar-api-key
