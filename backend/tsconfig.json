{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2022",
        "lib": [
            "ES2023"
        ],
        "types": [
            "node"
        ],
        "skipLibCheck": true,
        "noEmit": true,
        "allowJs": true,
        "strict": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "../src/*"
            ]
        }
    },
    "include": [
        "**/*"
    ]
}